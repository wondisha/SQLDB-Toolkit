{
  "name": "sql-dashboard-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite --config vite.config.dev.mjs",
    "build": "vite build --config vite.config.prod.mjs",
    "build:dev": "vite build --mode development --config vite.config.dev.mjs",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"frontend/**/*.js\"",
    "format": "prettier --write \"{src,test,frontend}/**/*.{js,css,html}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{src,test,frontend}/**/*.{js,css,html}\" \"*.{json,md,yml,yaml}\"",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "dist/**/*",
      "public/**/*",
      "audit_log.json"
    ],
    "outputPath": "."
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "mssql": "12.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
