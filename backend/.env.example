# Copy this file to .env and fill in your instance details.
# Used only if servers.json is not present.

DB_ID=default
DB_LABEL=Default Instance
DB_SERVER=localhost
DB_NAME=master
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=5000
DB_REQUEST_TIMEOUT_MS=15000

# Port the dashboard API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (your frontend origin)
CORS_ORIGIN=*
