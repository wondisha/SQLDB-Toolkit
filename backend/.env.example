# Copy this file to .env and fill in your instance details.
# Used only if servers.json is not present.

DB_ID=default
DB_LABEL=Default Instance
DB_SERVER=localhost
DB_NAME=master
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=5000
DB_REQUEST_TIMEOUT_MS=15000
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=0
DB_POOL_IDLE_TIMEOUT_MS=30000

# Port the dashboard API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
QUERY_CACHE_TTL_MS=15000
STATIC_CACHE_MAX_AGE_SECONDS=300
